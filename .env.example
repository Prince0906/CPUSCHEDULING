# OpenAI API Key for AI-powered algorithm analysis
# Get your key from: https://platform.openai.com/api-keys
# 
# If this variable is set, it will be used for all users automatically.
# If not set, users will be prompted to enter their own API key in the UI.
#
# SECURITY NOTE: 
# - Never commit .env files to version control
# - The .env file is already in .gitignore
# - This server-side key is never exposed to the client

OPENAI_API_KEY=sk-your-api-key-here
